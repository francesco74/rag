# Tutti i parametri letti dal backend (common/config.py e api/src/review_routes.py).
#
# Le righe attive sono quelle da compilare; le righe commentate mostrano il valore
# predefinito e servono solo se lo si vuole cambiare.
#
# Con docker-compose.yml il file da usare è .env.local (vedi misc/local/env.example):
# il blocco "environment" del compose ha la precedenza su host, porte e
# dimensionamento qui sotto. In Kubernetes i valori stanno in ConfigMap e Secret.
#
# Non si impostano qui le configurazioni di archivi e siti (scelta delle serie e
# periodo nei Filtri, home page, prompt): si gestiscono dall'area di amministrazione.


# =============================================================================
# OBBLIGATORI
# =============================================================================

# Chiave del fornitore scelto con LLM_PROVIDER ed EMBEDDING_PROVIDER.
API_LLM_KEY=
# Chiave per le chiamate alla chat senza sito (mai nei frontend).
API_SECRET_KEY=
# Firma delle sessioni di revisione: almeno 32 caratteri.
AUTH_SECRET_KEY=

MYSQL_PASSWORD=
BROKER_USERNAME=
BROKER_PASSWORD=

# Sicr@Web: senza queste variabili il backend non parte. Senza Sicr@Web basta un
# valore qualsiasi, come in docker-compose.yml.
DOCWS_RICERCA_ENDPOINT=
DOCWS_ATTI_ENDPOINT=
DOCWS_CODICE_AMMINISTRAZIONE=
DOCWS_CODICE_AOO=
RUOLO_DOCWS=


# =============================================================================
# SERVIZI
# =============================================================================

# MYSQL_SERVICE_HOST=localhost
# MYSQL_SERVICE_PORT=3306
# MYSQL_USER=raguser
# MYSQL_DATABASE=rag_db
# Solo docker-compose.yml: password di root del container MySQL.
# MYSQL_ROOT_PASSWORD=

# BROKER_HOST=rabbitmq-service.rag.svc.cluster.local
# BROKER_PORT=5672
# BROKER_MAX_ATTEMPTS=30

# REDIS_HOST=localhost
# REDIS_PORT=6379

# QDRANT_HOST=localhost
# QDRANT_PORT=6333


# =============================================================================
# GENERALI
# =============================================================================

# LOG_LEVEL=INFO
# HTTP_TIMEOUT_SECONDS=300
# Predefinito: la cartella di common/.
# DATA_FOLDER=/data
# Predefinito: il nome della macchina.
# HOSTNAME=
# Elenco separato da virgole; predefinito: tutte le origini.
# ALLOWED_ORIGINS=*
# Secondi prima che una modifica a un sito arrivi agli altri processi.
# SITE_CACHE_SECONDS=10


# =============================================================================
# SICR@WEB
# =============================================================================

# WS_USERNAME=sicraweb
# WS_PASSWORD=sicraweb
# VERIFY_TLS=true
# SOAP_VERSION=1.1
# ID_TIPO_ITER_DECRETO_PRESIDENZIALE=8
# ID_TIPO_ITER_DECRETO_DELIBERATIVO=9,19


# =============================================================================
# LLM
# =============================================================================

# gemini, openai, anthropic, mistral oppure local.
# LLM_PROVIDER=gemini
# Con provider local i modelli sono quelli del server (tag Ollama o nome vLLM).
# QUERY_REWRITER_MODEL_NAME=gemini-3.1-flash-lite
# ANSWER_GENERATOR_MODEL_NAME=gemini-3.5-flash
# GRADER_MODEL_NAME=gemini-3.1-flash-lite
# ANSWER_THINKING_LEVEL=LOW
# GRADER_THINKING_LEVEL=MINIMAL
# Vuoto, 0 o auto: il massimo del modello.
# ANSWER_MAX_TOKENS=
# GRADER_MAX_TOKENS=256
# MAX_MODEL_RETRIES=3
# ALLOW_GENERAL_KNOWLEDGE=true

# Con LLM_PROVIDER=local: ollama oppure vllm.
# LOCAL_LLM_BACKEND=ollama
# Ollama: senza /v1.
# LOCAL_LLM_HOST=http://localhost:11434
# vLLM: con /v1.
# LOCAL_VLLM_BASE_URL=http://localhost:8000/v1
# LOCAL_VLLM_API_KEY=


# =============================================================================
# EMBEDDING
# Cambiare fornitore, modello o dimensione richiede di ricalcolare i vettori di
# tutte le collection: python -m utils.migrate_embeddings (misc/migrations/MIGRAZIONE_EMBEDDING.md).
# =============================================================================

# EMBEDDING_PROVIDER=gemini
# EMBEDDING_DIMENSION=768
# Con EMBEDDING_PROVIDER=local. Dispositivo vuoto: rilevato da solo.
# LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
# LOCAL_EMBEDDING_DEVICE=
# Con EMBEDDING_PROVIDER=vllm. EMBEDDING_DIMENSION = dimensione nativa del modello
# (Qwen3-Embedding-4B: 2560, bge-m3: 1024).
# LOCAL_VLLM_EMBEDDING_MODEL=
# LOCAL_VLLM_EMBEDDING_BASE_URL=
# Solo per i modelli asimmetrici come Qwen3-Embedding: compito, in inglese, premesso
# alle domande della ricerca. Cambiarlo non richiede di ricalcolare i documenti.
# EMBEDDING_QUERY_INSTRUCTION=Given a question about administrative documents, retrieve the passages that answer it


# =============================================================================
# OCR
# =============================================================================

# gemini, openai, anthropic, mistral oppure local (usa LOCAL_LLM_BACKEND).
# OCR_PROVIDER=gemini
# Con un server locale il modello deve essere multimodale.
# Obbligatorio se OCR_PROVIDER non è gemini.
# OCR_MODEL_NAME=gemini-3-flash-preview
# OCR_RATE_PER_MINUTE=10
# OCR_MAX_ATTEMPTS=6
# In automatico (ingestione e /convert) si usa solo il modello scelto qui sopra, locale o
# no: se fallisce, il documento va in errore, senza altri tentativi altrove. L'OCR esterno parte solo dal pulsante "Trascrivi con
# OCR esterno" in revisione: prima questo modello, poi Vision se abilitato sotto. Con true
# gli altri tre sono obbligatori; fornitori: gemini, openai, anthropic, mistral.
# OCR_EXTERNAL_FALLBACK=false
# OCR_EXTERNAL_ALTERNATIVE_PROVIDER=gemini
# OCR_EXTERNAL_ALTERNATIVE_MODEL_NAME=gemini-3-flash-preview
# OCR_EXTERNAL_API_KEY=
# Vision per il pulsante in revisione, se il modello esterno fallisce o è spento. Mai in
# automatico. false, o credenziali assenti: Vision non si usa mai.
# OCR_VISION_FALLBACK=true
# Percorso di credentials.json, per Vision.
# GOOGLE_APPLICATION_CREDENTIALS=
# Solo docker-compose.yml: la cartella che contiene credentials.json.
# GOOGLE_CREDENTIALS_DIR=
# MAX_ALLOWED_PAGES=300


# =============================================================================
# RICERCA
# =============================================================================

# QDRANT_SEMANTIC_SIZE=30
# Similarità minima della ricerca vettoriale: dipende dal modello di embedding e va
# rivista quando lo si cambia. Con Qwen3-Embedding-4B il rumore arriva a ~0.55-0.58.
# QDRANT_SEMANTIC_THRESHOLD=0.60
# document_chunks con i vettori su disco e una copia int8 in RAM (conta solo quando si
# crea la collection); la ricerca riordina i migliori OVERSAMPLING x candidati con i
# vettori pieni.
# QDRANT_CHUNKS_QUANTIZATION=true
# QDRANT_OVERSAMPLING=2.0
# QDRANT_SYNTACTIC_SIZE=20
# KEYWORD_MAX_HITS=1000
# QDRANT_CONCEPT_THRESHOLD=0.80
# QDRANT_CONCEPT_MAX_HITS=3
# MAX_SUB_QUERIES=5
# MAX_HISTORY_ITEMS=20

# onnx: modello locale su CPU (RERANKER_MODEL_PATH). vllm: cross-encoder su server,
# es. DGX. Cambiando modello vanno ricontrollate MIN_PROB_THRESHOLD ed EXTRA_PARENTS_MIN_PROB.
# RERANK_PROVIDER=onnx
# Con RERANK_PROVIDER=vllm. URL con /v1; vuoto: LOCAL_VLLM_BASE_URL.
# RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
# LOCAL_VLLM_RERANK_BASE_URL=
# Oltre questo tempo la ricerca prosegue con la similarità vettoriale.
# RERANK_TIMEOUT_SECONDS=30
# RERANK_SIZE=25
# RERANK_MAX_SIZE=30
# RERANK_TRUNCATE=1200
# RERANK_BATCH_SIZE=4
# RERANK_MAX_LENGTH=512
# RERANKER_MODEL_PATH=./model_cache/mmarco-mMiniLMv2-L12-H384-v1

# MIN_PROB_THRESHOLD=0.02
# PARENTS_PER_QUERY=4
# EXTRA_PARENTS=true
# EXTRA_PARENTS_MIN_PROB=0.5
# MMR_SIMILARITY_THRESHOLD=0.92
# BOILERPLATE_SIMILARITY_THRESHOLD=0.55


# =============================================================================
# CONTESTO PASSATO AL MODELLO
# =============================================================================

# MAX_CONTEXT_CHARS=30000
# CONTEXT_OVERFLOW_RATIO=0.15
# Se inferiore a CONTEXT_OVERFLOW_RATIO viene allineato a quello.
# CONTEXT_HARD_CAP_RATIO=0.20
# CONTEXT_FLOOR_RATIO=0.60
# CONTEXT_CAP_RATIO=0.40
# rerank oppure vector.
# CONTEXT_SCORE_SOURCE=rerank
# CONTEXT_SCORE_WEIGHT=best
# CONTEXT_SNAP_BOUNDARY=sentence
# CONTEXT_METADATA=true
# CONTEXT_METADATA_EXCLUDE=id_sicraweb,id_tipo_iter,percorso_originale,giorni_pubblicazione,classifica
# CONTEXT_METADATA_MAX_VALUE_CHARS=200


# =============================================================================
# DIMENSIONAMENTO
# =============================================================================

# Core assegnati al pod: in Kubernetes va impostato. Predefinito: i core della macchina.
# CPU_LIMIT=
# Uguale al --concurrency del comando Celery.
# CELERY_CONCURRENCY=1
# MAX_RERANKER_THREAD=2
# Se inferiore a MAX_RERANKER_THREAD viene allineato a quello.
# RERANKER_POOL_SIZE=1


# =============================================================================
# REVISIONE E ACCESSI
# =============================================================================

# false solo senza HTTPS, come in locale.
# SESSION_COOKIE_SECURE=true
# REVIEW_SESSION_HOURS=10
# REVIEW_LOCK_TTL_SECONDS=300
# Proxy fidati davanti all'API, per ricavare l'IP reale del client.
# TRUSTED_PROXY_HOPS=0
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900
# LOGIN_IP_MAX_FAILURES=20
# Prefisso interno di nginx per servire i file; vuoto: li serve l'API.
# FILES_X_ACCEL_PREFIX=
# FILES_LOGIN_URL=/amministrazione/
# CONVERT_MAX_UPLOAD_MB=50
# Limite di ogni file caricato; nginx deve ammetterlo (client_max_body_size).
# UPLOAD_MAX_MB=100
# CONVERT_RETENTION_HOURS=48
