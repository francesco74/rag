# Installazione Docker di produzione del rag: copiare in .env e compilare (guida: README.md).
# Il file contiene password e chiavi: permessi 600, mai nel repository.
# Tutte le altre impostazioni del rag (elenco completo nel .env.example della radice) si
# possono aggiungere qui: arrivano a API, worker, converter e ingestione.

# --------------------------------------------------------------------- immagini
# Nome: REGISTRY/PREFISSO + componente + :VERSIONE (vedi deploy/immagini.sh)
REGISTRY=registry.intranet.provincia.lucca/rag
PREFISSO=
VERSIONE=v4.0.0

# --------------------------------------------------------------------- accesso
# Porta del gateway sul server. 127.0.0.1 = solo dal server stesso (atti-pa sulla stessa
# macchina usa la rete Docker "rag"; l'amministrazione con un tunnel SSH). Per atti-pa su un
# altro server: l'indirizzo della rete interna, con il firewall che ammette solo quel server.
RAG_INDIRIZZO=127.0.0.1
RAG_PORTA=8090

# --------------------------------------------------------------------- segreti
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
BROKER_USERNAME=rag
BROKER_PASSWORD=
# Firma delle sessioni dell'amministrazione: almeno 32 caratteri casuali
AUTH_SECRET_KEY=
# Chiave della chat: i siti non ci sono, ma l'API la richiede comunque
API_SECRET_KEY=
# Chiave dei fornitori esterni di LLM/embedding/OCR (vuota con vLLM)
API_LLM_KEY=

# --------------------------------------------------------------------- modelli (vLLM)
LLM_PROVIDER=vllm
LOCAL_VLLM_BASE_URL=http://10.1.1.132:8000/v1
# Nomi esatti pubblicati da vLLM: curl http://10.1.1.132:8000/v1/models
QUERY_REWRITER_MODEL_NAME=qwen3.5-35b-fp8
ANSWER_GENERATOR_MODEL_NAME=qwen3.5-35b-fp8
GRADER_MODEL_NAME=qwen3.5-35b-fp8
GRADER_THINKING_LEVEL=off

EMBEDDING_PROVIDER=vllm
LOCAL_VLLM_EMBEDDING_MODEL=Qwen3-Embedding-4B
LOCAL_VLLM_EMBEDDING_BASE_URL=http://10.1.1.132:8002/v1
# Cambiarla dopo l'avvio richiede utils.migrate_embeddings
EMBEDDING_DIMENSION=2560

RERANK_PROVIDER=vllm
RERANK_MODEL_NAME=bge-reranker-v2-m3
LOCAL_VLLM_RERANK_BASE_URL=http://10.1.1.132:8001/v1

# OCR delle pagine scansionate (local = backend di LLM_PROVIDER); il modello deve leggere le immagini
OCR_PROVIDER=local
OCR_MODEL_NAME=qwen3.5-35b-fp8
OCR_RATE_PER_MINUTE=10
# Facoltativo: cartella del server con credentials.json per il ripiego su Google Cloud Vision
# GOOGLE_CREDENTIALS_DIR=/opt/rag/google
OCR_VISION_FALLBACK=false

# --------------------------------------------------------------------- Sicr@Web
# Obbligatori per l'avvio anche senza estrazione (valori qualunque se non si usa)
DOCWS_RICERCA_ENDPOINT=https://ente.sicraweb.maggioli.cloud/client/services/DocWSRicercheSoap12
DOCWS_ATTI_ENDPOINT=https://ente.sicraweb.maggioli.cloud/client/services/WSattiSoap
DOCWS_CODICE_AMMINISTRAZIONE=
DOCWS_CODICE_AOO=
RUOLO_DOCWS=
WS_USERNAME=
WS_PASSWORD=

# --------------------------------------------------------------------- risorse e log
# Core del server per il worker e processi Celery
CPU_LIMIT=4
CELERY_CONCURRENCY=1
LOG_LEVEL=INFO
# Caricamenti dal sito di amministrazione (sotto i 110 MB del gateway)
UPLOAD_MAX_MB=100
