# Configurazione del sistema in locale: copiare in .env.local (ignorato da git).

# Unico valore da procurarsi: chiave per LLM ed embedding.
API_LLM_KEY=inserire-la-chiave

# Solo per le prove in locale: non riusare in produzione.
MYSQL_ROOT_PASSWORD=locale-root
MYSQL_PASSWORD=locale-rag
BROKER_USERNAME=rag
BROKER_PASSWORD=locale-rabbit
API_SECRET_KEY=locale-chiave-chat
AUTH_SECRET_KEY=locale-firma-sessioni-almeno-32-caratteri

LOG_LEVEL=INFO

# Facoltativo: cartella con credentials.json, per il ripiego su Google Cloud Vision
# GOOGLE_CREDENTIALS_DIR=/percorso/cartella
